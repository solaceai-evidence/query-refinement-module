# Query Refinement API Configuration — Anthropic / Claude Sonnet 4.6
# ===================================================================
# Copy this file to .env to run the API service against Anthropic Claude.
#
#   cp .env.anthropic-claude-sonnet-4-6 .env
#
# Prerequisites:
#   1. An Anthropic API key: https://console.anthropic.com/settings/keys
#   2. Set QUERY_REFINEMENT_LLM_API_KEY to your key before starting.
#
# Prompt caching is enabled by default — it reduces cost and latency for
# repeated system prompts (requires Anthropic API Tier 1 or above).

# ======================
# Environment
# ======================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text
LOG_FILE=logs/query_refinement.log

# ======================
# Security Settings
# ======================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ======================
# CORS Configuration
# ======================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8001

# ======================
# LLM Provider Settings — Anthropic (cloud)
# ======================
REFINEMENT_FRAMEWORK_PATH=./refinement_frameworks/frameworks.yaml

# Model: Anthropic Claude Sonnet 4.6.
# To use a different Claude model, replace the value below, e.g.:
#   anthropic/claude-opus-4-5
#   anthropic/claude-haiku-3-5
QUERY_REFINEMENT_LLM_MODEL=anthropic/claude-sonnet-4-6

# Your Anthropic API key (required)
# Get from: https://console.anthropic.com/settings/keys
QUERY_REFINEMENT_LLM_API_KEY=

# Internal defaults already match Anthropic:
#   - prompt caching defaults to enabled
#   - prompt variant stays on the production prompt set
#   - constrained decoding stays off
# Set QUERY_REFINEMENT_LLM_API_BASE only if you are routing Anthropic through a proxy.

# Temperature: 0.0 for deterministic eval runs
QUERY_REFINEMENT_LLM_TEMPERATURE=0.0

# Max tokens for the *response* (not the context window)
QUERY_REFINEMENT_LLM_MAX_TOKENS=4096

# ======================
# Application Settings
# ======================
DATABASE_URL=sqlite:///query_refinement.db
SESSION_STORAGE_BACKEND=memory

INTEGRATION_API_KEY=your-integration-api-key-here
INTEGRATION_SERVICE_USERNAME=api_integration_service
ALLOW_REGISTRATION=true

# Circuit breaker — enabled to protect against runaway retries
QUERY_REFINEMENT_ENABLE_CIRCUIT_BREAKER=true

# ======================
# Rate Limiting — tuned for Anthropic API tier limits
# ======================
LLM_RATE_LIMIT_RPM=60              # Anthropic Tier 1 limit; increase if on higher tier
LLM_RATE_LIMIT_TPM=40000           # Anthropic Tier 1 tokens per minute
LLM_MAX_CONCURRENT=10              # Max concurrent LLM requests

LLM_RATE_LIMIT_PER_USER_RPM=4     # Per-user max requests per minute
LLM_MAX_CONCURRENT_PER_USER=2

# Adaptive rate limiting backs off automatically on 429 responses
LLM_ADAPTIVE_RATE_LIMITING=true
LLM_ADAPTIVE_DECREASE_FACTOR=0.8
LLM_ADAPTIVE_INCREASE_FACTOR=1.05
LLM_ADAPTIVE_INCREASE_INTERVAL=60

RATE_LIMITER_BACKEND=memory
REDIS_URL=redis://redis:6379/0
REDIS_RATE_LIMIT_PREFIX=qr:ratelimit
