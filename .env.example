# =================================================================
# Query Refinement Module - Environment Configuration
# =================================================================
# This file provides configuration templates for development and
# production environments. Copy to .env and customize for your setup.
#
# Quick Start:
#   - Development: Use SQLite, basic settings
#   - Production: Use PostgreSQL, enable pooling, structured logging
# =================================================================

# -----------------------------------------------------------------
# 1. APPLICATION SETTINGS
# -----------------------------------------------------------------
# Environment: development, staging, or production
ENVIRONMENT=development

# Debug mode (disable in production)
DEBUG=true

# Application version (for logging and monitoring)
APP_VERSION=1.0.0


# -----------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# -----------------------------------------------------------------
# Development (SQLite):
DATABASE_URL=sqlite:///./query_refinement.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql://username:password@localhost:5432/query_refinement

# Connection Pool Settings (PostgreSQL only)
# Number of connections to maintain in the pool
DB_POOL_SIZE=5

# Maximum overflow connections beyond pool_size
DB_POOL_MAX_OVERFLOW=10

# Connection timeout in seconds
DB_POOL_TIMEOUT=30

# Recycle connections after this many seconds (prevents stale connections)
DB_POOL_RECYCLE=3600

# Test connections before using them
DB_POOL_PRE_PING=true

# Echo SQL queries (development only)
DB_ECHO=false


# -----------------------------------------------------------------
# 3. REDIS CONFIGURATION
# -----------------------------------------------------------------
# Redis connection URL for sessions and rate limiting
# Development:
REDIS_URL=redis://localhost:6379/0

# Production with authentication:
# REDIS_URL=redis://:password@redis-host:6379/0

# Session configuration
REDIS_SESSION_DB=0
REDIS_SESSION_PREFIX=session:

# Rate limiting configuration
REDIS_RATE_LIMIT_DB=1
REDIS_RATE_LIMIT_PREFIX=ratelimit:


# -----------------------------------------------------------------
# 4. SECURITY SETTINGS
# -----------------------------------------------------------------
# Secret key for JWT tokens and session encryption
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# JWT token expiration (in minutes)
JWT_EXPIRATION_MINUTES=60

# Session timeout (in minutes)
SESSION_TIMEOUT_MINUTES=120

# Allowed authentication methods
ALLOWED_AUTH_METHODS=api_key,jwt


# -----------------------------------------------------------------
# 5. CORS CONFIGURATION
# -----------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
# Development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Production:
# ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Allow credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=true

# Allowed HTTP methods
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed headers
CORS_ALLOW_HEADERS=*

# Max age for preflight requests (seconds)
CORS_MAX_AGE=3600


# -----------------------------------------------------------------
# 6. LLM PROVIDER CONFIGURATION
# -----------------------------------------------------------------
# Primary LLM provider (openai, anthropic, azure, or vertex)
LLM_PROVIDER=openai

# API Keys (set only the ones you need)
OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# AZURE_API_KEY=your-azure-api-key
# VERTEX_PROJECT_ID=your-gcp-project-id

# Model selection
LLM_MODEL=gpt-4o-mini

# Temperature for response generation (0.0-1.0)
LLM_TEMPERATURE=0.3

# Maximum tokens for responses
LLM_MAX_TOKENS=4000

# Request timeout (seconds)
LLM_TIMEOUT=60


# -----------------------------------------------------------------
# 7. RATE LIMITING
# -----------------------------------------------------------------
# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Global rate limits
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Per-user rate limits
RATE_LIMIT_PER_USER_REQUESTS_PER_MINUTE=30
RATE_LIMIT_PER_USER_REQUESTS_PER_HOUR=500

# Rate limit storage backend (redis or memory)
RATE_LIMIT_STORAGE=redis


# -----------------------------------------------------------------
# 8. PARALLEL EXECUTION
# -----------------------------------------------------------------
# Enable parallel processing for subdimensions
PARALLEL_ENABLED=false

# Maximum number of parallel workers
PARALLEL_MAX_WORKERS=4

# Timeout for parallel tasks (seconds)
PARALLEL_TIMEOUT=30


# -----------------------------------------------------------------
# 9. LOGGING CONFIGURATION
# -----------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: text or json (use json for production)
LOG_FORMAT=text

# Log file path (optional, leave empty to disable file logging)
# LOG_FILE=logs/app.log

# Log file rotation
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# Request logging (log all API requests)
LOG_REQUESTS=true

# SQL query logging
LOG_SQL_QUERIES=false


# -----------------------------------------------------------------
# 10. SERVER CONFIGURATION
# -----------------------------------------------------------------
# Server host and port (development)
HOST=0.0.0.0
PORT=8000

# Gunicorn workers (production)
# Recommended: (2 x CPU cores) + 1
WORKERS=5

# Worker class (use uvicorn.workers.UvicornWorker for async)
WORKER_CLASS=uvicorn.workers.UvicornWorker

# Request timeout (seconds)
TIMEOUT=120

# Keepalive timeout (seconds)
KEEPALIVE=5

# Max requests per worker before restart
MAX_REQUESTS=1000

# Max requests jitter (random variation)
MAX_REQUESTS_JITTER=100


# -----------------------------------------------------------------
# 11. DOCKER CONFIGURATION (when using docker-compose)
# -----------------------------------------------------------------
# PostgreSQL service
POSTGRES_USER=queryrefine
POSTGRES_PASSWORD=queryrefine_password
POSTGRES_DB=query_refinement
POSTGRES_PORT=5432

# Redis service
REDIS_PORT=6379

# API service
API_PORT=8000


# -----------------------------------------------------------------
# 12. MONITORING & HEALTH CHECKS
# -----------------------------------------------------------------
# Enable health check endpoints
HEALTH_CHECK_ENABLED=true

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# Enable metrics collection
METRICS_ENABLED=false

# Metrics port (if separate from main API)
# METRICS_PORT=9090


# -----------------------------------------------------------------
# 13. CUSTOM SCHEMA CONFIGURATION
# -----------------------------------------------------------------
# Directory for custom schema YAML files
SCHEMA_DIRECTORY=./examples

# Default schema file
DEFAULT_SCHEMA=pico_template.yaml


# =================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =================================================================
# Before deploying to production, ensure you:
# 
# [x] 1. Generate a secure SECRET_KEY
# [x] 2. Set ENVIRONMENT=production
# [x] 3. Set DEBUG=false
# [x] 4. Configure PostgreSQL DATABASE_URL
# [x] 5. Configure Redis with authentication
# [x] 6. Set production ALLOWED_ORIGINS
# [x] 7. Review and adjust connection pool settings
# [x] 8. Set LOG_FORMAT=json for structured logging
# [x] 9. Configure appropriate rate limits
# [x] 10. Set secure POSTGRES_PASSWORD
# [x] 11. Configure Gunicorn workers based on CPU count
# [x] 12. Enable HTTPS/TLS termination (load balancer/reverse proxy)
# [x] 13. Set up log aggregation (if using LOG_FILE)
# [x] 14. Configure monitoring and alerting
# [x] 15. Test health check endpoints (/health, /ready)
# [x] 16. Run database migrations (alembic upgrade head)
# [x] 17. Review security headers and CORS settings
# [x] 18. Set up backup procedures for PostgreSQL
# [x] 19. Configure firewalls and network security
# [x] 20. Test with production-like load (see Step 5)
# =================================================================

