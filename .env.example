# Query Refinement API Configuration
# Copy this file to .env and update with your settings

# ======================
# Database Configuration
# ======================
DATABASE_URL=sqlite:///query_refinement.db
# For PostgreSQL: postgresql://user:password@localhost:5432/query_refinement

# ======================
# Security Settings
# ======================
SECRET_KEY=your-secret-key-change-this-in-production-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================
# CORS Configuration
# ======================
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ======================
# LLM Provider Settings
# ======================
# Full path to YAML custom schemas file
REFINEMENT_FRAMEWORK_PATH=examples/pico_template.yaml

# Optional path to YAML follow-up prompts file (NOT IN USE YET)
# FOLLOWUP_PROMPTS_PATH=/path/to/your/followup_prompts.yaml

# Default LLM model id used by both CLI and API service (required)
QUERY_REFINEMENT_LLM_MODEL=anthropic/claude-sonnet-4-20250514

# LLM API credentials and configuration
QUERY_REFINEMENT_LLM_API_KEY=your-api-key-here

# Optional base URL for LLM API endpoint (e.g. for self-hosted or proxy setups)
QUERY_REFINEMENT_LLM_API_BASE=

# 0.0 keeps sampling deterministic. 0.2 adds a gentle increase in variety/randomness
QUERY_REFINEMENT_LLM_TEMPERATURE=0.2

# Maximum tokens for the LLM response; leave empty to use vendor/model default
QUERY_REFINEMENT_LLM_MAX_TOKENS=

# JSON object for additional completion kwargs (e.g. {"top_p":0.8, "response_format":"json"})
# for vendor-specific tuning. Not currently applied as there is no need to override behaviour
# for Anthropic/OpenAI in this module
QUERY_REFINEMENT_LLM_COMPLETION_KWARGS=

# ======================
# Rate Limiting Configuration
# ======================

# Global Rate Limits (shared across all users and sessions)
# These protect the LLM API from overload and control costs
LLM_RATE_LIMIT_RPM=50              # Max requests per minute (0 = unlimited)
LLM_RATE_LIMIT_TPM=40000           # Max tokens per minute (leave empty for unlimited)
LLM_MAX_CONCURRENT=5               # Max concurrent LLM requests (0 = unlimited)

# Per-User Rate Limits (fairness in multi-tenant deployments)
# Each user gets their own quota, preventing abuse
LLM_RATE_LIMIT_PER_USER_RPM=10    # Per-user max requests per minute
LLM_MAX_CONCURRENT_PER_USER=3     # Per-user max concurrent requests

# Adaptive Rate Limiting (dynamically adjust on 429 errors)
LLM_ADAPTIVE_RATE_LIMITING=true                # Enable/disable adaptive backoff
LLM_ADAPTIVE_DECREASE_FACTOR=0.8              # Reduce by 20% on rate limit error
LLM_ADAPTIVE_INCREASE_FACTOR=1.05             # Increase by 5% during recovery
LLM_ADAPTIVE_INCREASE_INTERVAL=60             # Recovery adjustment every 60 seconds

# Rate Limiter Backend
RATE_LIMITER_BACKEND=memory        # Options: "memory" (single instance) or "redis" (distributed)
REDIS_URL=redis://localhost:6379/0 # Required if RATE_LIMITER_BACKEND=redis
REDIS_RATE_LIMIT_PREFIX=qr:ratelimit

# ======================
# Provider-Specific Recommendations
# ======================

# Anthropic Claude (default tier)
# LLM_RATE_LIMIT_RPM=50
# LLM_RATE_LIMIT_TPM=40000
# LLM_MAX_CONCURRENT=5

# Anthropic Claude (scale tier)
# LLM_RATE_LIMIT_RPM=1000
# LLM_RATE_LIMIT_TPM=400000
# LLM_MAX_CONCURRENT=20

# OpenAI GPT-4 (default tier)
# LLM_RATE_LIMIT_RPM=60
# LLM_RATE_LIMIT_TPM=90000
# LLM_MAX_CONCURRENT=10

# OpenAI GPT-4 (scale tier)
# LLM_RATE_LIMIT_RPM=10000
# LLM_RATE_LIMIT_TPM=2000000
# LLM_MAX_CONCURRENT=50

# Local Models (Ollama, vLLM, llama.cpp)
# LLM_RATE_LIMIT_RPM=0    # Unlimited
# LLM_MAX_CONCURRENT=10   # Adjust based on GPU memory

# ======================
# Parallel Execution Configuration
# ======================
# Enable parallel aspect analysis during session initialization
# When enabled, aspects at the same dependency level are analyzed in parallel
# while respecting rate limits and dependency order
PARALLEL_EXECUTION_ENABLED=false

# CLI Parallel Mode (separate from API parallel execution)
# Controls whether the CLI uses parallel execution by default
# Can be overridden with --parallel or --no-parallel flags
QUERY_REFINEMENT_PARALLEL_MODE=true

# Maximum concurrent aspect analyses per dependency level
# Example: If level 0 has 8 aspects and PARALLEL_MAX_CONCURRENT=5,
# they will be processed in two batches (5 + 3)
PARALLEL_MAX_CONCURRENT=5

# Retry configuration for rate-limited calls
PARALLEL_MAX_RETRIES=3
PARALLEL_BACKOFF_BASE_DELAY=1.0     # Initial delay in seconds
PARALLEL_BACKOFF_MAX_DELAY=60.0     # Maximum delay cap in seconds
PARALLEL_BACKOFF_MULTIPLIER=2.0     # Exponential growth factor
PARALLEL_BACKOFF_JITTER=0.1         # Randomness factor (0.0-1.0)

