# =================================================================
# Query Refinement Module - Minimal Configuration
# =================================================================
# Copy this file to .env and set your values.
# Only essential settings needed for prototype evaluation.
# =================================================================

# -----------------------------------------------------------------
# REQUIRED: LLM Configuration
# -----------------------------------------------------------------
# Your LLM model (supports Anthropic Claude, OpenAI GPT-4, etc.)
QUERY_REFINEMENT_LLM_MODEL=anthropic/claude-sonnet-4-20250514

# Your LLM API key (required)
# Get from: https://console.anthropic.com/settings/keys (Anthropic)
#           https://platform.openai.com/api-keys (OpenAI)
QUERY_REFINEMENT_LLM_API_KEY=your-api-key-here

# Path to framework YAML file (default: frameworks.yaml)
REFINEMENT_FRAMEWORK_PATH=./refinement_frameworks/frameworks.yaml


# -----------------------------------------------------------------
# REQUIRED: Application Settings
# -----------------------------------------------------------------
# Database location (SQLite for local development)
DATABASE_URL=sqlite:///query_refinement.db

# Secret key for session encryption
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# External system integration API key (optional)
# Set this to allow service-to-service calls using X-API-Key instead of user JWT login
INTEGRATION_API_KEY=

# Internal username used for integration requests (optional override)
INTEGRATION_SERVICE_USERNAME=api_integration_service

# Allow self-service registration (set false for credential-only access)
ALLOW_REGISTRATION=true


# -----------------------------------------------------------------
# OPTIONAL: Fine-tuning
# -----------------------------------------------------------------
# Temperature controls response randomness (0.0 = deterministic, 1.0 = creative)
QUERY_REFINEMENT_LLM_TEMPERATURE=0.2

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional log file path (in addition to stdout)
LOG_FILE=

# CORS origins for web frontend (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Host path for persistent Postgres/Redis bind mounts (Docker)
DATA_ROOT=./data

