# Development environment — cloud LLM (API key required)
# ─────────────────────────────────────────────────────────────────────────────
# Use this template for any cloud-hosted LLM provider: Anthropic, OpenAI, etc.
# Copy to .env then fill in LLM_MODEL, LLM_API_KEY, and SECRET_KEY.
#
#   cp .env.cloud .env
#
# Rate limits, prompt caching, timeouts, and context window are auto-detected
# from the model name prefix (anthropic/*, openai/*, gemini/*, …).
#
# To override provider-specific settings (rate-limit tier, caching):
#   config/providers/anthropic.yaml   (then set LLM_PROVIDER_PRESET=anthropic)

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── Framework ─────────────────────────────────────────────────────────────────
REFINEMENT_FRAMEWORK_PATH=./refinement_frameworks/frameworks.yaml

# ── LLM ───────────────────────────────────────────────────────────────────────
# Replace with your provider and model, e.g.:
#   anthropic/claude-sonnet-4-6   openai/gpt-4o   gemini/gemini-2.5-pro
LLM_MODEL=anthropic/claude-sonnet-4-6
LLM_API_KEY=        # Required — get from your provider's console

# Activate a provider preset for rate-limit and caching overrides:
# LLM_PROVIDER_PRESET=anthropic

# ── Security ──────────────────────────────────────────────────────────────────
# Insecure placeholder is fine for local dev; production needs a real value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-secret-for-local-only

# ── Web App behaviour ─────────────────────────────────────────────────────────────
ALLOW_REGISTRATION=true
API_RATE_LIMIT_PER_USER_RPM=4      # Tighter per-user cap for local testing

# ── Optional overrides ────────────────────────────────────────────────────────
# INTEGRATION_API_KEY=              # For external service-to-service calls
# LOG_FILE=logs/query_refinement.log
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8001
