# Query Refinement API Configuration - Self-hosted vLLM
# ======================================================
# Copy this file to .env to run the API service against a local vLLM server.
#
#   cp .env.vllm .env
#
# Prerequisites:
#   1. vLLM installed: pip install vllm
#   2. vLLM server running, e.g.:
#        ./start_vllm.sh
#      On macOS, vLLM runs CPU-only.
#   3. Verify it's available: curl http://localhost:8000/v1/models
#
# IMPORTANT: LLM_CONSTRAINED_DECODING must only be set to true
# when LLM_API_BASE points at a vLLM server.  Setting it for
# Anthropic / OpenAI / Ollama will break structured output for those providers.

# ======================
# Environment
# ======================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text
LOG_FILE=logs/query_refinement.log

# ======================
# Security Settings
# ======================
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ======================
# CORS Configuration
# ======================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8001

# ======================
# LLM Provider Settings — vLLM (self-hosted)
# ======================
REFINEMENT_FRAMEWORK_PATH=./refinement_frameworks/frameworks.yaml

# Model loaded into the vLLM server. Use an 8B-class model for local testing.
#   openai/meta-llama/Llama-3.1-8B-Instruct   (recommended local default)
#
# The 'openai/' prefix is required by LiteLLM to route calls through the
# OpenAI-compatible provider when a custom api_base is set.
LLM_MODEL=openai/meta-llama/Llama-3.1-8B-Instruct

# vLLM uses "EMPTY" as the conventional placeholder API key for local servers
LLM_API_KEY=EMPTY

# Hugging Face token for gated Meta Llama models served through vLLM.
# Use the token from `hf auth login` or set it in your shell before starting vLLM.
HF_TOKEN=

# Base URL of the vLLM OpenAI-compatible REST API
LLM_API_BASE=http://localhost:8000/v1

# Enable vLLM constrained decoding (guided_json via extra_body).
# This enforces the full Pydantic JSON Schema at the token level,
# guaranteeing structurally valid output from both the dimension evaluation
# and synthesis stages without any post-hoc repair.
LLM_CONSTRAINED_DECODING=true

# Prompt caching is Anthropic-specific — disable for vLLM
LLM_ENABLE_PROMPT_CACHING=false

# Temperature: 0.0 = deterministic, higher = more varied responses
LLM_TEMPERATURE=0.2

# Max tokens for the *response* (not the context window).
# vLLM uses --max-model-len at server start to set the context window;
# no num_ctx override is needed here (unlike Ollama).
LLM_MAX_OUTPUT_TOKENS=4096

# No Ollama-specific COMPLETION_KWARGS needed for vLLM.
# Do NOT set LLM_COMPLETION_KWARGS here.

# ======================
# Application Settings
# ======================
DATABASE_URL=sqlite:///query_refinement.db
SESSION_STORAGE_BACKEND=memory

INTEGRATION_API_KEY=your-integration-api-key-here
INTEGRATION_SERVICE_USERNAME=api_integration_service
ALLOW_REGISTRATION=true

# ======================
# API Ingress Rate Limiting
# ======================
# Keep ingress open locally and rely on backend guardrails.
API_RATE_LIMIT_RPM=0
API_RATE_LIMIT_PER_USER_RPM=0
API_RATE_LIMITER_BACKEND=memory
REDIS_URL=redis://redis:6379/0
API_REDIS_RATE_LIMIT_PREFIX=qr:ratelimit

# ======================
# LLM Provider Runtime Limits — Self-hosted vLLM
# ======================
# vLLM is GPU-bound; keep concurrency low to avoid OOM / request timeouts.
LLM_PROVIDER_RATE_LIMIT_RPM=0               # 0 = unlimited
LLM_PROVIDER_RATE_LIMIT_TPM=0               # 0 = unlimited
LLM_PROVIDER_MAX_CONCURRENT=4               # Keep low — GPU memory is the bottleneck

LLM_PROVIDER_ADAPTIVE_RATE_LIMIT=false
LLM_PROVIDER_ADAPTIVE_DECREASE_FACTOR=0.8
LLM_PROVIDER_ADAPTIVE_INCREASE_FACTOR=1.05
LLM_PROVIDER_ADAPTIVE_INCREASE_INTERVAL=60
