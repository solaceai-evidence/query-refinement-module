# Production environment — Anthropic Claude Sonnet 4.6
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in every value marked "Required" before deploying.
#
# Values not listed here use the code default (see api/config.py and
# settings.py). Provider rate limits, prompt caching, timeouts, and DB pool
# sizes are auto-detected from the model name prefix (anthropic/*).
#
# To override rate limits (e.g. for a higher Anthropic tier), edit:
#   config/providers/anthropic.yaml   (then set LLM_PROVIDER_PRESET=anthropic)

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_FORMAT=json
LOG_FILE=/var/log/query-refinement/api.log

# ── Framework ─────────────────────────────────────────────────────────────────
REFINEMENT_FRAMEWORK_PATH=/app/refinement_frameworks/frameworks.yaml

# ── Security ──────────────────────────────────────────────────────────────────
# Required — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALLOWED_ORIGINS=https://your-domain.example
ALLOW_REGISTRATION=false
ENFORCE_WORKFLOW_LIMIT=false

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_MODEL=anthropic/claude-sonnet-4-6
LLM_API_KEY=                       # Required
LLM_TEMPERATURE=0.2                # Slightly warmer than dev default (0.0)

# Enable adaptive back-off in production (slows down automatically on 429 errors):
LLM_PROVIDER_ADAPTIVE_RATE_LIMIT=true

# Override if your Anthropic account is on a higher rate-limit tier:
# LLM_PROVIDER_RATE_LIMIT_RPM=50
# LLM_PROVIDER_RATE_LIMIT_TPM=40000
# LLM_PROVIDER_MAX_CONCURRENT=5

# ── Service-to-service integration (optional) ─────────────────────────────────
# INTEGRATION_API_KEY=

# ── Database (Docker Compose uses these to build DATABASE_URL for the API) ────
POSTGRES_USER=qruser
POSTGRES_PASSWORD=                  # Required
POSTGRES_DB=query_refinement
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_MAX_CONNECTIONS=100
SESSION_STORAGE_BACKEND=redis
SESSION_TTL_SECONDS=10800          # 3 hours (default is 1 hour)
API_RATE_LIMITER_BACKEND=redis

# ── Server / Nginx (Docker Compose port bindings) ─────────────────────────────
API_PORT=8001
API_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
DATA_ROOT=./data

# ── Workers ───────────────────────────────────────────────────────────────────
# gunicorn_conf.py auto-calculates from CPU count if WORKERS is unset.
WORKERS=4
