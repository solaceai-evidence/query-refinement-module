# Production Environment Configuration
# Optimized for 20 concurrent users with 2-3 CPUs

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/query-refinement/api.log

# Security
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=https://your-frontend.example,https://your-api.example
ALLOW_REGISTRATION=false

# Service-to-service integration auth
# Use this for external systems calling /api/v1/refinement/* without end-user login
INTEGRATION_API_KEY=
INTEGRATION_SERVICE_USERNAME=api_integration_service

# Database (Docker Compose canonical path uses POSTGRES_* to build API DATABASE_URL)
POSTGRES_USER=qruser
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=query_refinement
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
# DATABASE_URL is intentionally omitted in canonical compose production.
# The API container derives it from POSTGRES_* values.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=3600

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_MAX_CONNECTIONS=100
SESSION_TTL_SECONDS=10800

# API / Nginx published ports
API_PORT=8001
API_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Host path for persistent Postgres/Redis bind mounts
DATA_ROOT=./data

# LLM Settings
QUERY_REFINEMENT_LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
QUERY_REFINEMENT_LLM_API_KEY=
QUERY_REFINEMENT_LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# LLM Rate Limits (global + per-user)
LLM_RATE_LIMIT_RPM=60
LLM_RATE_LIMIT_TPM=40000
LLM_MAX_CONCURRENT=10
LLM_RATE_LIMIT_PER_USER_RPM=20
LLM_MAX_CONCURRENT_PER_USER=5

# Frameworks
REFINEMENT_FRAMEWORK_PATH=/app/refinement_frameworks/frameworks.yaml

# API Rate Limiting (per user)
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_BURST=5
ENFORCE_WORKFLOW_LIMIT=false

# Worker Configuration
# For 2 CPUs: 4 workers is safe
# For 3 CPUs: 7 workers (auto-calculated by gunicorn_conf.py)
WORKERS=4
