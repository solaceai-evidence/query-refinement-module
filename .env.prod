# Production environment configuration — Anthropic Claude Sonnet 4.6
# Copy this file to .env and fill in all placeholder values before deploying.

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/query-refinement/api.log

# Security
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=https://your-domain.example
ALLOW_REGISTRATION=false

# Service-to-service integration auth
# Use this for external systems calling /api/v1/refinement/* without end-user login
INTEGRATION_API_KEY=
INTEGRATION_SERVICE_USERNAME=api_integration_service

# Database (Docker Compose canonical path uses POSTGRES_* to build API DATABASE_URL)
POSTGRES_USER=qruser
POSTGRES_PASSWORD=your-database-password-here
POSTGRES_DB=query_refinement
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
# DATABASE_URL is intentionally omitted in canonical compose production.
# The API container derives it from POSTGRES_* values.
# 4 workers × (pool_size + max_overflow) must stay under POSTGRES_MAX_CONNECTIONS=100
# 4 × (5 + 10) = 60 connections — leaves 40 for Alembic/admin
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=3600

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_MAX_CONNECTIONS=100
SESSION_TTL_SECONDS=10800
SESSION_STORAGE_BACKEND=redis
RATE_LIMITER_BACKEND=redis
REDIS_RATE_LIMIT_PREFIX=qr:ratelimit

# API / Nginx published ports
API_PORT=8001
API_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Host path for persistent Postgres/Redis bind mounts
DATA_ROOT=./data

# LLM Settings
QUERY_REFINEMENT_LLM_MODEL=anthropic/claude-sonnet-4-6
QUERY_REFINEMENT_LLM_API_KEY=
QUERY_REFINEMENT_LLM_TEMPERATURE=0.2
QUERY_REFINEMENT_LLM_MAX_TOKENS=4096
# Circuit breaker trips after 5 consecutive LLM failures; recovers after 60 s
QUERY_REFINEMENT_ENABLE_CIRCUIT_BREAKER=true
QUERY_REFINEMENT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
QUERY_REFINEMENT_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60.0

# LLM Rate Limits — Anthropic Tier 3 ceilings: 1,000 RPM / 200,000 TPM
LLM_RATE_LIMIT_RPM=600             # 60 participants × ~10 RPM peak; hard cap 1,000
LLM_RATE_LIMIT_TPM=200000          # Tier 3 limit for Claude Sonnet 4.6
LLM_MAX_CONCURRENT=30              # Handles burst load from 60 participants
LLM_RATE_LIMIT_PER_USER_RPM=20     # Fair-use cap per participant
LLM_MAX_CONCURRENT_PER_USER=5      # Per-participant concurrency

# Adaptive rate limiting (dynamically backs off on 429 errors)
LLM_ADAPTIVE_RATE_LIMITING=true
LLM_ADAPTIVE_DECREASE_FACTOR=0.8
LLM_ADAPTIVE_INCREASE_FACTOR=1.05
LLM_ADAPTIVE_INCREASE_INTERVAL=60

# Frameworks
REFINEMENT_FRAMEWORK_PATH=/app/refinement_frameworks/frameworks.yaml

ENFORCE_WORKFLOW_LIMIT=false

# Worker Configuration
# For 2 CPUs: 4 workers is safe
# For 3 CPUs: 7 workers (auto-calculated by gunicorn_conf.py)
WORKERS=4
