# QueryRefine Configuration File
# Copy this file to .env and configure your settings

# ============================================================================
# LLM API Configuration
# ============================================================================

# Your LLM API Key (REQUIRED)
# Get from: https://platform.openai.com/api-keys or https://console.anthropic.com/settings/keys
QUERY_REFINEMENT_LLM_API_KEY=your-api-key-here

# LLM Provider (REQUIRED)
# Options: openai, anthropic, azure, etc.
QUERY_REFINEMENT_LLM_PROVIDER=openai

# LLM Model (OPTIONAL)
# Examples: gpt-4, gpt-3.5-turbo, claude-3-opus-20240229, claude-3-sonnet-20240229
QUERY_REFINEMENT_LLM_MODEL=gpt-4

# ============================================================================
# Framework Configuration
# ============================================================================

# Path to refinement framework YAML file (OPTIONAL)
# Default: uses built-in frameworks
# REFINEMENT_FRAMEWORK_PATH=./sample_framework.yaml

# ============================================================================
# Application Settings
# ============================================================================

# Log Level (OPTIONAL)
# Options: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Database URL (OPTIONAL)
# Default: SQLite in current directory
# DATABASE_URL=sqlite:///./query_refinement.db
