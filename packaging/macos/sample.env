# =================================================================
# Query Refinement Module - Configuration
# =================================================================
# Copy this file to .env in the same directory as the app
# =================================================================

# -----------------------------------------------------------------
# REQUIRED: LLM Configuration
# -----------------------------------------------------------------
# Your LLM model (supports Anthropic Claude, OpenAI GPT-4, etc.)
QUERY_REFINEMENT_LLM_MODEL=anthropic/claude-sonnet-4-20250514

# Your LLM API key (REQUIRED - get from provider)
# Anthropic: https://console.anthropic.com/settings/keys
# OpenAI: https://platform.openai.com/api-keys
QUERY_REFINEMENT_LLM_API_KEY=your-api-key-here

# -----------------------------------------------------------------
# OPTIONAL: Fine-tuning
# -----------------------------------------------------------------
# Temperature controls response randomness (0.0 = deterministic, 1.0 = creative)
QUERY_REFINEMENT_LLM_TEMPERATURE=0.2

# Maximum tokens for response (leave empty for default)
QUERY_REFINEMENT_LLM_MAX_TOKENS=4096

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
