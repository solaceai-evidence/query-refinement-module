# Development environment — self-hosted inference server (vLLM / llama.cpp / TGI)
# ─────────────────────────────────────────────────────────────────────────────
# Use this template for any OpenAI-compatible inference server running separately.
#
#   cp .env.selfhosted .env
#
# Prerequisites:
#   1. Start the inference server first:  ./start_vllm.sh [model-name]
#      Default model: meta-llama/Llama-3.1-8B-Instruct (port 8000)
#   2. Make sure LLM_MODEL below matches the model you started the server with.
#
# Auto-detected for openai/* models when LLM_API_BASE is set (no need to set in .env):
#   timeout  →  30 min (allows for slow local inference)
#   rate limits  →  unlimited

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── Framework ─────────────────────────────────────────────────────────────────
REFINEMENT_FRAMEWORK_PATH=./refinement_frameworks/frameworks.yaml

# ── LLM ───────────────────────────────────────────────────────────────────────
# Prefix any model name with openai/ — that signals the OpenAI-compatible API path.
# Must match the model the server was started with, e.g.:
#   openai/meta-llama/Llama-3.1-8B-Instruct   openai/mistralai/Mistral-7B-Instruct-v0.3
LLM_MODEL=openai/meta-llama/Llama-3.1-8B-Instruct
# Port must match the inference server (vLLM default: 8000, llama.cpp default: 8080)
LLM_API_BASE=http://localhost:8000

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=dev-insecure-secret-for-local-only

# ── App behaviour ─────────────────────────────────────────────────────────────
ALLOW_REGISTRATION=true

# ── Optional overrides ────────────────────────────────────────────────────────
# INTEGRATION_API_KEY=
# LOG_FILE=logs/query_refinement.log
