# Query Refinement API Configuration - Local Ollama
# =====================================================
# Copy this file to .env to run the API service against a local Ollama instance.
#
#   cp .env.ollama .env
#
# Prerequisites:
#   1. Ollama installed and running: https://ollama.com
#   2. Model pulled: ollama pull qwen2.5:32b
#   3. Verify it's available: ollama list

# ======================
# Environment
# ======================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text
LOG_FILE=logs/query_refinement.log

# ======================
# Security Settings
# ======================
# Secret key for session encryption
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ======================
# CORS Configuration
# ======================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8001

# ======================
# LLM Provider Settings — Ollama (local)
# ======================
REFINEMENT_FRAMEWORK_PATH=./refinement_frameworks/frameworks.yaml

# Model served by local Ollama.
# To switch to a different model: ollama pull <model> and update this value.
# Examples:
#   ollama/qwen2.5:32b
#   ollama/qwen2.5:14b
#   ollama/llama3.3:70b
#   ollama/mistral:latest
QUERY_REFINEMENT_LLM_MODEL=ollama/qwen2.5:32b

# No API key required for local Ollama
QUERY_REFINEMENT_LLM_API_KEY=

# Base URL of the local Ollama REST API (default port: 11434)
QUERY_REFINEMENT_LLM_API_BASE=http://localhost:11434

# Prompt caching is Anthropic-specific — must be disabled for Ollama
QUERY_REFINEMENT_ENABLE_PROMPT_CACHING=false

# Constrained decoding (guided_json) — only for vLLM servers; not supported by Ollama
QUERY_REFINEMENT_LLM_CONSTRAINED_DECODING=false

# Temperature: 0.0 = deterministic, higher = more varied responses
QUERY_REFINEMENT_LLM_TEMPERATURE=0.2

# Max tokens for the *response* (not the context window)
# Leave generous headroom — structured JSON responses can be verbose
QUERY_REFINEMENT_LLM_MAX_TOKENS=2048

# Ollama-specific options passed through litellm on every completion call.
# num_ctx: context window size (Ollama default is only 2048 — too small for this application).
# qwen2.5:32b supports up to 128K; 16K covers full framework YAML + all prior
# dimension results (with ~4 GB KV-cache overhead).
# Increase to 32768 if you see truncation; decrease to 8192 to save memory.
QUERY_REFINEMENT_LLM_COMPLETION_KWARGS={"num_ctx": 16384}

# ======================
# Application Settings
# ======================
DATABASE_URL=sqlite:///query_refinement.db

INTEGRATION_API_KEY=your-integration-api-key-here
INTEGRATION_SERVICE_USERNAME=api_integration_service
ALLOW_REGISTRATION=true

# ======================
# Rate Limiting — relaxed for local use
# ======================
# Local Ollama has no external rate limits; these are soft guardrails only.
LLM_RATE_LIMIT_RPM=0               # 0 = unlimited
LLM_RATE_LIMIT_TPM=0               # 0 = unlimited
LLM_MAX_CONCURRENT=4               # Keep low — large local models are memory-bound

LLM_RATE_LIMIT_PER_USER_RPM=0     # 0 = unlimited
LLM_MAX_CONCURRENT_PER_USER=2

# No adaptive rate limiting needed for a local provider
LLM_ADAPTIVE_RATE_LIMITING=false
LLM_ADAPTIVE_DECREASE_FACTOR=0.8
LLM_ADAPTIVE_INCREASE_FACTOR=1.05
LLM_ADAPTIVE_INCREASE_INTERVAL=60

# In-memory backend is fine for single-instance local testing
RATE_LIMITER_BACKEND=memory
REDIS_URL=redis://redis:6379/0
REDIS_RATE_LIMIT_PREFIX=qr:ratelimit
