# Production Environment Configuration Template
# Copy this file to .env.production and update with your actual values

ENVIRONMENT=production

# Database (PostgreSQL for production)
DATABASE_URL=postgresql://query_user:YOUR_SECURE_PASSWORD_HERE@postgres:5432/query_refinement_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Redis for sessions and rate limiting
REDIS_URL=redis://redis:6379/0
SESSION_STORAGE_BACKEND=redis
RATE_LIMITER_BACKEND=redis

# CORS (update with your frontend domains)
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Security
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting (scaled for 100 concurrent users)
LLM_RATE_LIMIT_RPM=1000
LLM_MAX_CONCURRENT=50
LLM_RATE_LIMIT_PER_USER_RPM=20
LLM_MAX_CONCURRENT_PER_USER=5

# LLM Configuration
QUERY_REFINEMENT_LLM_MODEL=anthropic/claude-sonnet-4-20250514
QUERY_REFINEMENT_LLM_API_KEY=YOUR_API_KEY_HERE
QUERY_REFINEMENT_LLM_TEMPERATURE=0.2
QUERY_REFINEMENT_ENABLE_PROMPT_CACHING=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=9
WORKER_TIMEOUT=120

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
