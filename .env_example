# Full path to YAML custom schemas file
REFINEMENT_FRAMEWORK_PATH=user_path/query-refinement-module/examples/custom_schemas.yaml

#FOLLOWUP_PROMPTS_PATH=user_path/query-refinement-module/examples/followup_prompts.yaml

# Default LLM model id (example provided below) used by both CLI and API service (required)
QUERY_REFINEMENT_LLM_MODEL="anthropic/claude-sonnet-4-20250514"

# Optional overrides forwarded to LiteLLMProvider / LLMQueryAnalyzer
QUERY_REFINEMENT_LLM_API_KEY=""
# Optional base URL for LLM API endpoint (e.g. for self-hosted or proxy setups)
QUERY_REFINEMENT_LLM_API_BASE=""
# 0.0 keeps sampling determinsitic. 0.2 adds a gentle increase in variety/randomness
QUERY_REFINEMENT_LLM_TEMPERATURE="0.2"
# Maximum tokens for the LLM response; leave empty to use vendor/model default
QUERY_REFINEMENT_LLM_MAX_TOKENS=""

# JSON object for additional completion kwargs (e.g. {"top_p":0.8, "response_format":"json"}) for vendor specific tuning
# Not currently applied as there is no need to override behaviour for Athropic/OpenAI in this module
QUERY_REFINEMENT_LLM_COMPLETION_KWARGS=""