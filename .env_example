# Full path to YAML custom schemas file
REFINEMENT_FRAMEWORK_PATH=""

# Default LLM model id used by both CLI and API service (required)
QUERY_REFINEMENT_LLM_MODEL="gpt-4o-mini"

# Optional overrides forwarded to LiteLLMProvider / LLMQueryAnalyzer
QUERY_REFINEMENT_LLM_API_KEY=""
QUERY_REFINEMENT_LLM_API_BASE=""
QUERY_REFINEMENT_LLM_TEMPERATURE="0.0"
QUERY_REFINEMENT_LLM_MAX_TOKENS=""

# JSON object for additional completion kwargs (e.g. {"top_p":0.8})
QUERY_REFINEMENT_LLM_COMPLETION_KWARGS=""