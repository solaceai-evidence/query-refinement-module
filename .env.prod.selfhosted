# Production environment — local/self-hosted inference (Ollama or OpenAI-compatible)
# Copy this file to .env and fill in all placeholder values before deploying.
#
# This template assumes the API runs in Docker Compose and the inference server
# runs outside this stack (on the host or another machine). Set LLM_API_BASE
# to an address the API container can reach.

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/query-refinement/api.log

# Security
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=https://your-domain.example
ALLOW_REGISTRATION=false

# Service-to-service integration auth
# Use this for external systems calling /api/v1/refinement/* without end-user login
INTEGRATION_API_KEY=
INTEGRATION_SERVICE_USERNAME=api_integration_service

# Database (Docker Compose canonical path uses POSTGRES_* to build API DATABASE_URL)
POSTGRES_USER=qruser
POSTGRES_PASSWORD=your-database-password-here
POSTGRES_DB=query_refinement
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
# DATABASE_URL is intentionally omitted in canonical compose production.
# The API container derives it from POSTGRES_* values.
# 4 workers × (pool_size + max_overflow) must stay under POSTGRES_MAX_CONNECTIONS=100
# 4 × (5 + 10) = 60 connections — leaves 40 for Alembic/admin
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=3600

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_MAX_CONNECTIONS=100
SESSION_TTL_SECONDS=10800
SESSION_STORAGE_BACKEND=redis
API_RATE_LIMITER_BACKEND=redis
API_REDIS_RATE_LIMIT_PREFIX=qr:ratelimit

# API / Nginx published ports
API_PORT=8001
API_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Host path for persistent Postgres/Redis bind mounts
DATA_ROOT=./data

# LLM Settings — local/self-hosted inference
# Set LLM_MODEL to your model with the appropriate prefix:
#   ollama/qwen2.5:72b                                  (Ollama runner)
#   openai/meta-llama/Llama-3.1-70B-Instruct            (vLLM / TGI / llama.cpp)
LLM_MODEL=ollama/qwen2.5:72b
# Must be reachable from inside the API container, not just from the host shell.
# Ollama examples:  http://192.168.1.50:11434   http://ollama.internal.example:11434
# vLLM examples:    http://192.168.1.50:8000    http://vllm.internal.example:8000
LLM_API_BASE=http://your-inference-host:11434
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=4096
# Optional override only if you need more or less than the built-in 16K default:
# LLM_COMPLETION_KWARGS={"num_ctx": 32768}
# Circuit breaker trips after 5 consecutive LLM failures; recovers after 60 s
LLM_ENABLE_CIRCUIT_BREAKER=true
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60.0

# API ingress limits. Keep ingress open and let the backend guardrails govern throughput.
API_RATE_LIMIT_RPM=0
API_RATE_LIMIT_PER_USER_RPM=0

# LLM provider runtime limits — local/self-hosted Ollama guardrails
LLM_PROVIDER_RATE_LIMIT_RPM=0
LLM_PROVIDER_RATE_LIMIT_TPM=0
LLM_PROVIDER_MAX_CONCURRENT=1

# Adaptive rate limiting is unnecessary for a local/self-hosted Ollama backend
LLM_PROVIDER_ADAPTIVE_RATE_LIMIT=false
LLM_PROVIDER_ADAPTIVE_DECREASE_FACTOR=0.8
LLM_PROVIDER_ADAPTIVE_INCREASE_FACTOR=1.05
LLM_PROVIDER_ADAPTIVE_INCREASE_INTERVAL=60

# Frameworks
REFINEMENT_FRAMEWORK_PATH=/app/refinement_frameworks/frameworks.yaml

ENFORCE_WORKFLOW_LIMIT=false

# Worker Configuration
# For a single 72B Ollama backend, keep app worker fan-out conservative.
WORKERS=4