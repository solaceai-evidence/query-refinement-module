# Development environment — local inference runner (Ollama)
# ─────────────────────────────────────────────────────────────────────────────
# Use this template for any Ollama-managed local model. No API key required.
#
#   cp .env.local .env
#
# Prerequisites:
#   1. Ollama running locally: https://ollama.com/download
#   2. Model pulled: ollama pull <model-name>
#
# Auto-detected for ollama/* models (no need to set in .env):
#   LLM_API_BASE  →  http://localhost:11434
#   context size  →  16 384 tokens
#   timeout       →  30 min (allows for slow local inference)
#   rate limits   →  unlimited
#
# To customise any of the above, edit:
#   config/providers/ollama.yaml   (then set LLM_PROVIDER_PRESET=ollama)

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── Framework ─────────────────────────────────────────────────────────────────
REFINEMENT_FRAMEWORK_PATH=./refinement_frameworks/frameworks.yaml

# ── LLM ───────────────────────────────────────────────────────────────────────
# Replace with any model you have pulled locally, e.g.:
#   ollama/qwen2.5:72b 
LLM_MODEL=ollama/qwen2.5:72b
# LLM_API_BASE=http://localhost:11434  # auto-detected; uncomment to override

# Activate YAML preset for Ollama-specific overrides (context window, remote host):
# LLM_PROVIDER_PRESET=ollama

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-secret-for-local-only

# ── Web App behaviour ─────────────────────────────────────────────────────────
ALLOW_REGISTRATION=true

# ── Optional overrides ────────────────────────────────────────────────────────
# INTEGRATION_API_KEY=    # For external service-to-service calls

# for local dev, uncomment to log to file instead of stdout
# LOG_FILE=logs/query_refinement.log
